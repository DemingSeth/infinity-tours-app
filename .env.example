# Supabase, safe to expose to the browser (anon/publishable key, RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only secret used to HMAC-sign the guest "tour_session" cookie that
# remembers a validated access code for the rest of the day. Must NOT be
# prefixed with NEXT_PUBLIC (never expose it to the browser). Rotating it
# invalidates all existing guest sessions.
# Generate a long random value, e.g.:  openssl rand -hex 32
TOUR_SESSION_SECRET=

# Server-only Supabase service role key. Read by lib/supabase/admin.ts, which is
# used by the Team Access actions at /admin/users: sending an invite, and
# removing an account that never accepted one. Both need the auth admin API and
# the ability to write tour_hosts.role, neither of which is granted to an
# ordinary signed-in session. It bypasses RLS, so it must NOT be prefixed with
# NEXT_PUBLIC, and lib/supabase/admin.ts imports "server-only" so a build that
# ever pulled it into a client component would fail rather than ship it.
# Without it the Team Access screen still loads and invites return a plain
# message naming this variable.
# Supabase dashboard: Project Settings, API, service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# There is deliberately no site URL variable. The invite link's base is derived
# from the headers of the request that sends it (x-forwarded-host and
# x-forwarded-proto), so production, preview deploys and localhost each build
# their own. The address in the invite EMAIL comes from the project's Site URL in
# the Supabase dashboard, not from here. See supabase/email-templates/README.md.
